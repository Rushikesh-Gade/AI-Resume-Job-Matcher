# AWS Configuration
AWS_REGION=ap-south-1
S3_RESUME_BUCKET=resume-matcher-resumes
S3_COVERLETTER_BUCKET=resume-matcher-coverletters

# DynamoDB Tables
DYNAMODB_USERS_TABLE=ResumeMatcherUsers
DYNAMODB_RESUMES_TABLE=ResumeMatcherResumes
DYNAMODB_JOBS_TABLE=ResumeMatcherJobs
DYNAMODB_MATCHES_TABLE=ResumeMatcherMatches
DYNAMODB_APPLICATIONS_TABLE=ResumeMatcherApplications

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# Job Scraping
SCRAPING_DELAY=2
MAX_JOBS_PER_SOURCE=200

# Matching
MIN_MATCH_SCORE=50
HIGH_MATCH_THRESHOLD=70

# Email Configuration
SES_SENDER_EMAIL=noreply@resumematcher.com
SES_REGION=ap-south-1

# Security
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Performance
LAMBDA_TIMEOUT_SECONDS=300
BATCH_SIZE=50
